        }
      },
      "functions": {
        "availability_budget_consumed": {
          "signature": "fn availability_budget_consumed(burn: Scalar, window: Time, period: Time) -> Scalar",
          "description": "Fraction of the error budget used when a burn rate holds for a window: burn * window / period. Workbook example: 36 times over 1 hour in a 30-day period uses 5%",
          "examples": [
            {
              "code": "availability_budget_consumed(36, 1 hour, 30 days)",
              "value": "0.05",
              "type": "Scalar"
            }
          ]
        },
        "availability_burn_rate": {
          "signature": "fn availability_burn_rate(error_rate: Scalar, slo: Scalar) -> Scalar",
          "description": "Burn rate: how fast, relative to the SLO, a service uses its error budget. It is error_rate / (1 - slo), with error_rate from 0 to 1 (pass 0.0072 or 0.72%, not 0.72) and slo as 0.9995 or 99.95%. A burn rate of 1 uses exactly the whole budget over the SLO period. Unreliable at low traffic: one failed request can give a very high burn rate",
          "examples": [
            {
              "code": "availability_burn_rate(0.72%, 99.95%)",
              "value": "14.4",
              "type": "Scalar"
            }
          ]
        },
        "availability_burn_threshold": {
          "signature": "fn availability_burn_threshold(consumed: Scalar, window: Time, period: Time) -> Scalar",
          "description": "Burn rate at which an alert window uses a given fraction of the budget: consumed * period / window, the formula of availability_budget_consumed solved for the burn rate. Workbook Table 5-8: 2% in 1 hour of a 30-day period is 14.4, and 5% in 6 hours is 6",
          "examples": [
            {
              "code": "availability_burn_threshold(2%, 1 hour, 30 days)",
              "value": "14.4",
              "type": "Scalar"
            }
          ]
        },
        "availability_downtime_month": {
          "signature": "fn availability_downtime_month(a: Scalar) -> Time",
          "description": "Average downtime per month at availability fraction a (0 ≤ a ≤ 1; pass 0.999 or 99.9%, not 99.9), using Numbat's average month unit. 99.9% is ~44 min, 99.99% is ~4.4 min",
          "examples": [
            {
              "code": "availability_downtime_month(0.999)",
              "value": "0.001 month",
              "type": "Time"
            }
          ]
        },
        "availability_downtime_year": {
          "signature": "fn availability_downtime_year(a: Scalar) -> Time",
          "description": "Downtime per year at availability fraction a (0 ≤ a ≤ 1; pass 0.999 or 99.9%, not 99.9). 99.9% is ~8.8 h, 99.99% is ~53 min, 99.999% is ~5.3 min",
          "examples": [
            {
              "code": "availability_downtime_year(0.999)",
              "value": "0.001 yr",
              "type": "Time"
            }
          ]
        },
        "availability_from_mtbf": {
          "signature": "fn availability_from_mtbf(mtbf: Time, mttr: Time) -> Scalar",
          "description": "Availability estimated from mean time between failures and mean time to recover: mtbf / (mtbf + mttr). AWS example: an MTBF of 150 days and an MTTR of 1 hour is about 99.97%",
          "examples": [
            {
              "code": "availability_from_mtbf(150 days, 1 hour)",
              "value": "0.999722",
              "type": "Scalar"
            }
          ]
        },
        "availability_nines": {
          "signature": "fn availability_nines(n: Scalar) -> Scalar",
          "description": "Availability with n nines (n ≥ 0): availability_nines(4) is 0.9999",
          "examples": [
            {
              "code": "availability_nines(4)",
              "value": "0.9999",
              "type": "Scalar"
            }
          ]
        },
        "availability_parallel": {
          "signature": "fn availability_parallel(a: Scalar, n: Scalar) -> Scalar",
          "description": "Availability of n independent replicas where any one suffices: 1 - (1 - a)^n. Pass availability a from 0 to 1 and a nonnegative replica count n",
          "examples": [
            {
              "code": "availability_parallel(0.99, 3)",
              "value": "0.999999",
              "type": "Scalar"
            }
          ]
        },
        "availability_serial": {
          "signature": "fn availability_serial(a: Scalar, b: Scalar) -> Scalar",
          "description": "Availability of two components in series (both must work): multiply their availability fractions a and b, each from 0 to 1",
          "examples": [
            {
              "code": "availability_serial(0.99, 0.999)",
              "value": "0.98901",
              "type": "Scalar"
            }
          ]
        }
      }
    },
    "capacity": {
      "values": {
        "capacity_peak_factor": {
          "value": "3",
          "type": "Scalar"
        },
        "capacity_seconds_per_day": {
          "value": "86400 s",
          "type": "Time"
        },
        "capacity_target_utilization": {
          "value": "0.7",
          "type": "Scalar"
        }
      },
      "functions": {
        "capacity_concurrency": {
          "signature": "fn capacity_concurrency<R: Dim>(rate: R / Time, w: Time) -> R",
          "description": "Concurrency in flight (Little's Law, L = lambda * W): rate times time",
          "examples": [
            {
              "code": "capacity_concurrency(200 request/s, 0.5 s)",
              "value": "100 request",
              "type": "Request"
            }
          ]
        },
        "capacity_fanout_slow": {
          "signature": "fn capacity_fanout_slow(p_slow: Scalar, n: Scalar) -> Scalar",
          "description": "Fraction of fan-out requests that hit at least one slow backend: 1 - (1 - p_slow)^n. 1% slow over 100 backends is 63%",
          "examples": [
            {
              "code": "capacity_fanout_slow(0.01, 100)",
              "value": "0.633968",
              "type": "Scalar"
            }
          ]
        },
        "capacity_nodes": {
          "signature": "fn capacity_nodes<D: Dim>(load: D, per_node: D) -> Scalar",
          "description": "Nodes so each runs at or below capacity_target_utilization (the module default). Pass your own utilization with capacity_nodes_with_utilization",
          "examples": [
            {
              "code": "capacity_nodes(5000 request/s, 1000 request/s)",
              "value": "8",
              "type": "Scalar"
            }
          ]
        },
        "capacity_nodes_with_utilization": {
          "signature": "fn capacity_nodes_with_utilization<D: Dim>(load: D, per_node: D, utilization: Scalar) -> Scalar",
          "description": "Nodes so each runs at or below a given utilization (0 < utilization ≤ 1): ceil(load / (per_node * utilization))",
          "examples": [
            {
              "code": "capacity_nodes_with_utilization(5000 request/s, 1000 request/s, 0.7)",
              "value": "8",
              "type": "Scalar"
            }
          ]
        },
        "capacity_response_multiplier": {
          "signature": "fn capacity_response_multiplier(rho: Scalar) -> Scalar",
          "description": "M/M/1 mean response time in units of service time, 1/(1-rho); requires 0 ≤ rho < 1. Values: 2x at 50%, 3.3x at 70%, 10x at 90%",
          "examples": [
            {
              "code": "capacity_response_multiplier(0.7)",
              "value": "3.33333",
              "type": "Scalar"
            }
          ]
        },
        "capacity_retry_amplification": {
          "signature": "fn capacity_retry_amplification(attempts: Scalar, depth: Scalar) -> Scalar",
          "description": "Load amplification when every layer retries: attempts^depth (Google SRE: 3 retries = 4 attempts at 3 layers is 64x)",
          "examples": [
            {
              "code": "capacity_retry_amplification(4, 3)",
              "value": "64",
              "type": "Scalar"
            }
          ]
        },
        "capacity_usl": {
          "signature": "fn capacity_usl(n: Scalar, alpha: Scalar, beta: Scalar) -> Scalar",
          "description": "Universal Scalability Law relative throughput C(N) for node count N > 0, contention alpha ≥ 0, and coherency beta ≥ 0",
          "examples": [
            {
              "code": "capacity_usl(8, 0.1, 0.01)",
              "value": "3.53982",
              "type": "Scalar"
            }
          ]
        },
        "capacity_usl_peak_nodes": {
          "signature": "fn capacity_usl_peak_nodes(alpha: Scalar, beta: Scalar) -> Scalar",
          "description": "Node count where USL throughput peaks, N* = sqrt((1 - alpha) / beta). Requires 0 ≤ alpha < 1 and beta > 0",
          "examples": [
            {
              "code": "capacity_usl_peak_nodes(0.1, 0.01)",
              "value": "9.48683",
              "type": "Scalar"
            }
          ]
        },
        "capacity_wait_multiplier": {
          "signature": "fn capacity_wait_multiplier(rho: Scalar) -> Scalar",
          "description": "M/M/1 mean queueing delay in units of service time, rho/(1-rho); requires 0 ≤ rho < 1. Values: 1.0 at 50%, 2.3 at 70%, 9.0 at 90%. A pool of many workers (M/M/c) queues far less at the same rho",
          "examples": [
            {
              "code": "capacity_wait_multiplier(0.7)",
              "value": "2.33333",
              "type": "Scalar"
            }
          ]
        }
      }
    },

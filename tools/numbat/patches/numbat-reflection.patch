new file mode 100644
index 00000000..1acaeb56
--- /dev/null
+++ b/numbat-wasm/src/eval.rs
@@ -0,0 +1,229 @@
+//! Evaluation as data.
+//!
+//! `Numbat.eval(code, source)` runs the code as `interpret` does and answers, instead of rendered text, what happened:
+//! `{"ok", "value", "type", "prints", "diagnostics", "uses", "effects"}`.
+//!
+//! - `value` and `type` are `values.rs` and `types.rs`; `type` is the type of the last statement when it is an expression.
+//! - `diagnostics` are the errors with their labels and notes, spans in UTF-16 units of the text they point into.
+//! - `uses` are the names the typechecker resolved: where each was used, what it is, and where it was defined (a source and a
+//!   span in it): the relation a go-to-definition or a colouring is made of.
+//! - `effects` says whether the code read the clock or the exchange rates.
+//!
+//! `source` says what the code is: empty is text typed into a sheet, `module:cost` a module, `file:line:3` a named file.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+
+use codespan_reporting::diagnostic::{LabelStyle, Severity};
+use numbat::diagnostic::{ErrorDiagnostic, ResolverDiagnostic};
+use numbat::facts::{Use, UseKind};
+use numbat::markup::{Formatter, PlainTextFormatter};
+use numbat::prefix::Prefix;
+use numbat::resolver::{CodeSource, ModulePath};
+use numbat::{InterpreterResult, InterpreterSettings, NumbatError};
+use wasm_bindgen::prelude::*;
+
+use crate::json::{J, utf16_offsets};
+use crate::types::scheme_json;
+use crate::values::value_json;
+use crate::Numbat;
+
+fn parse_source(source: &str) -> CodeSource {
+    if let Some(name) = source.strip_prefix("module:") {
+        CodeSource::Module(ModulePath(name.split("::").map(Into::into).collect()), None)
+    } else if let Some(name) = source.strip_prefix("file:") {
+        CodeSource::File(name.into())
+    } else {
+        CodeSource::Text
+    }
+}
+
+pub fn source_json(source: &CodeSource) -> J {
+    match source {
+        CodeSource::Text => J::obj(vec![("kind", J::s("text"))]),
+        CodeSource::Internal => J::obj(vec![("kind", J::s("internal"))]),
+        CodeSource::File(path) => J::obj(vec![("kind", J::s("file")), ("name", J::s(path.to_string_lossy().to_string()))]),
+        CodeSource::Module(path, _) => J::obj(vec![("kind", J::s("module")), ("name", J::s(path.to_string()))]),
+    }
+}
+
+/// Byte offsets of a source as UTF-16 units, for each source met (the text of the code, a module's, another line's).
+struct Offsets<'a> {
+    ctx: &'a numbat::Context,
+    tables: HashMap<usize, Option<Vec<usize>>>,
+}
+
+impl<'a> Offsets<'a> {
+    fn new(ctx: &'a numbat::Context) -> Self {
+        Offsets { ctx, tables: HashMap::new() }
+    }
+
+    /// `byte` of source `id` in UTF-16 units; the byte itself when the text of the source is not known.
+    fn units(&mut self, id: usize, byte: usize) -> usize {
+        let ctx = self.ctx;
+        let table = self.tables.entry(id).or_insert_with(|| ctx.source_text(id).map(|t| utf16_offsets(&t)));
+        match table {
+            Some(t) => t[byte.min(t.len() - 1)],
+            None => byte,
+        }
+    }
+}
+
+fn span_json(offsets: &mut Offsets, span: &numbat::span::Span) -> J {
+    let id = span.code_source_id;
+    J::obj(vec![
+        ("start", J::n(offsets.units(id, span.start.as_usize()))),
+        ("end", J::n(offsets.units(id, span.end.as_usize()))),
+    ])
+}
+
+fn use_json(offsets: &mut Offsets, u: &Use) -> J {
+    let (kind, extra): (&str, Vec<(&str, J)>) = match &u.kind {
+        UseKind::Variable => ("variable", vec![]),
+        UseKind::Function => ("function", vec![]),
+        UseKind::Unit { prefix, canonical } => (
+            "unit",
+            vec![
+                ("canonical", J::s(canonical.as_str())),
+                (
+                    "prefix",
+                    match prefix {
+                        None => J::Null,
+                        Some(Prefix::Metric(exp)) => J::obj(vec![("type", J::s("metric")), ("exp", J::Num(*exp as f64))]),
+                        Some(Prefix::Binary(exp)) => J::obj(vec![("type", J::s("binary")), ("exp", J::Num(*exp as f64))]),
+                    },
+                ),
+            ],
+        ),
+        UseKind::Predefined => ("predefined", vec![]),
+        UseKind::Dimension => ("dimension", vec![]),
+        UseKind::Struct => ("struct", vec![]),
+        UseKind::Unknown => ("unknown", vec![]),
+    };
+    let mut fields = vec![
+        ("span", span_json(offsets, &u.span)),
+        ("name", J::s(u.name.as_str())),
+        ("kind", J::s(kind)),
+    ];
+    fields.extend(extra);
+    if let Some(def) = &u.definition {
+        let source = source_json(&offsets.ctx.code_source(def.code_source_id));
+        fields.push(("definition", J::obj(vec![("source", source), ("span", span_json(offsets, def))])));
+    }
+    J::obj(fields)
+}
+
+fn diagnostic_json(offsets: &mut Offsets, d: &numbat::Diagnostic) -> J {
+    let severity = match d.severity {
+        Severity::Bug => "bug",
+        Severity::Error => "error",
+        Severity::Warning => "warning",
+        Severity::Note => "note",
+        Severity::Help => "help",
+    };
+    let labels = d
+        .labels
+        .iter()
+        .map(|l| {
+            J::obj(vec![
+                ("primary", J::Bool(matches!(l.style, LabelStyle::Primary))),
+                ("source", source_json(&offsets.ctx.code_source(l.file_id))),
+                ("start", J::n(offsets.units(l.file_id, l.range.start))),
+                ("end", J::n(offsets.units(l.file_id, l.range.end))),
+                ("message", J::s(l.message.as_str())),
+            ])
+        })
+        .collect();
+    J::obj(vec![
+        ("severity", J::s(severity)),
+        ("code", J::opt(d.code.as_ref().map(|c| J::s(c.as_str())))),
+        ("message", J::s(d.message.as_str())),
+        ("labels", J::Arr(labels)),
+        ("notes", J::Arr(d.notes.iter().map(|n| J::s(n.as_str())).collect())),
+    ])
+}
+
+fn diagnostics_of(ctx: &numbat::Context, error: &NumbatError) -> Vec<numbat::Diagnostic> {
+    match error {
+        NumbatError::ResolverError(e) => e.diagnostics(),
+        NumbatError::NameResolutionError(e) => e.diagnostics(),
+        NumbatError::TypeCheckError(e) => e.diagnostics(),
+        NumbatError::RuntimeError(e) => ResolverDiagnostic { resolver: ctx.resolver(), error: e }.diagnostics(),
+    }
+}
+
+#[wasm_bindgen]
+impl Numbat {
+    /// Run `code` and say what happened, as JSON (see the module doc).
+    pub fn eval(&mut self, code: &str, source: &str) -> String {
+        let printed: Arc<Mutex<Vec<numbat::markup::Markup>>> = Arc::new(Mutex::new(vec![]));
+        let sink = printed.clone();
+        let mut settings = InterpreterSettings {
+            print_fn: Box::new(move |m: &numbat::markup::Markup| sink.lock().unwrap().push(m.clone())),
+        };
+        let _ = numbat::facts::take_effects(); // what was read before this code is not this code's
+        let _ = self.ctx.take_uses(); // nor are the names resolved before it
+        let _ = numbat::facts::take_hole();
+        let result = self.ctx.interpret_with_settings(&mut settings, code, parse_source(source));
+        let effects = numbat::facts::take_effects();
+        // The names of this code, not of the modules it brought in (`use cost` resolves every name of `cost` too): the uses whose
+        // source is this code's text.
+        let uses: Vec<Use> = self
+            .ctx
+            .take_uses()
+            .into_iter()
+            .filter(|u| self.ctx.source_text(u.span.code_source_id).as_deref() == Some(code))
+            .collect();
+        let mut offsets = Offsets::new(&self.ctx);
+        let prints: Vec<J> = printed
+            .lock()
+            .unwrap()
+            .iter()
+            .map(|m| J::s(PlainTextFormatter {}.format(m, false).to_string()))
+            .collect();
+        let registry = self.ctx.dimension_registry();
+
+        let mut fields: Vec<(&str, J)> = Vec::new();
+        match &result {
+            Ok((statements, outcome)) => {
+                fields.push(("ok", J::Bool(true)));
+                let value = match outcome {
+                    InterpreterResult::Value(v) => value_json(v),
+                    InterpreterResult::Continue => J::Null,
+                };
+                fields.push(("value", value));
+                let ty = statements
+                    .last()
+                    .and_then(|s| s.as_expression())
+                    .map(|e| scheme_json(&e.get_type_scheme(), registry));
+                fields.push(("type", J::opt(ty)));
+                fields.push(("diagnostics", J::Arr(vec![])));
+            }
+            Err(error) => {
+                fields.push(("ok", J::Bool(false)));
+                fields.push(("value", J::Null));
+                fields.push(("type", J::Null));
+                let diagnostics = diagnostics_of(&self.ctx, error).iter().map(|d| diagnostic_json(&mut offsets, d)).collect();
+                fields.push(("diagnostics", J::Arr(diagnostics)));
+            }
+        }
+        // a typed hole (`?`): the type the typechecker expects there, and the names Numbat finds relevant for it
+        if let Some(hole) = numbat::facts::take_hole() {
+            fields.push((
+                "hole",
+                J::obj(vec![
+                    ("span", span_json(&mut offsets, &hole.span)),
+                    ("type", scheme_json(&hole.scheme, registry)),
+                    ("matches", J::Arr(hole.matches.iter().map(|m| J::s(m.as_str())).collect())),
+                ]),
+            ));
+        }
+        fields.push(("prints", J::Arr(prints)));
+        fields.push(("uses", J::Arr(uses.iter().map(|u| use_json(&mut offsets, u)).collect())));
+        fields.push((
+            "effects",
+            J::obj(vec![("clock", J::Bool(effects.clock)), ("exchangeRates", J::Bool(effects.exchange_rates))]),
+        ));
+        J::obj(fields).dump()
+    }
+}
diff --git a/numbat-wasm/src/json.rs b/numbat-wasm/src/json.rs
new file mode 100644
index 00000000..f10ebe72
--- /dev/null
+++ b/numbat-wasm/src/json.rs
@@ -0,0 +1,113 @@
+//! A small JSON value for what the wasm module answers (no dependency: the answers are plain data).
+
+use std::fmt::Write;
+
+#[derive(Debug, Clone)]
+pub enum J {
+    Null,
+    Bool(bool),
+    Num(f64),
+    Str(String),
+    Arr(Vec<J>),
+    Obj(Vec<(String, J)>),
+}
+
+impl J {
+    pub fn s(s: impl Into<String>) -> J {
+        J::Str(s.into())
+    }
+
+    pub fn n(n: usize) -> J {
+        J::Num(n as f64)
+    }
+
+    pub fn obj(fields: Vec<(&str, J)>) -> J {
+        J::Obj(fields.into_iter().map(|(k, v)| (k.to_string(), v)).collect())
+    }
+
+    pub fn opt(v: Option<J>) -> J {
+        v.unwrap_or(J::Null)
+    }
+
+    pub fn dump(&self) -> String {
+        let mut out = String::new();
+        self.write(&mut out);
+        out
+    }
+
+    fn write(&self, out: &mut String) {
+        match self {
+            J::Null => out.push_str("null"),
+            J::Bool(b) => out.push_str(if *b { "true" } else { "false" }),
+            J::Num(n) => {
+                if n.is_finite() {
+                    if n.fract() == 0.0 && n.abs() < 1e15 {
+                        let _ = write!(out, "{}", *n as i64);
+                    } else {
+                        let _ = write!(out, "{n}");
+                    }
+                } else {
+                    // JSON has no NaN or infinity: they are named, as strings
+                    out.push('"');
+                    out.push_str(if n.is_nan() { "NaN" } else if *n > 0.0 { "inf" } else { "-inf" });
+                    out.push('"');
+                }
+            }
+            J::Str(s) => write_string(s, out),
+            J::Arr(items) => {
+                out.push('[');
+                for (i, item) in items.iter().enumerate() {
+                    if i > 0 {
+                        out.push(',');
+                    }
+                    item.write(out);
+                }
+                out.push(']');
+            }
+            J::Obj(fields) => {
+                out.push('{');
+                for (i, (k, v)) in fields.iter().enumerate() {
+                    if i > 0 {
+                        out.push(',');
+                    }
+                    write_string(k, out);
+                    out.push(':');
+                    v.write(out);
+                }
+                out.push('}');
+            }
+        }
+    }
+}
+
+fn write_string(s: &str, out: &mut String) {
+    out.push('"');
+    for ch in s.chars() {
+        match ch {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c if (c as u32) < 0x20 => {
+                let _ = write!(out, "\\u{:04x}", c as u32);
+            }
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+}
+
+/// The offset of every byte of `text` in UTF-16 units (JavaScript's count), and one past the end.
+pub fn utf16_offsets(text: &str) -> Vec<usize> {
+    let mut units = vec![0usize; text.len() + 1];
+    let mut at = 0usize;
+    for (byte, ch) in text.char_indices() {
+        for k in 0..ch.len_utf8() {
+            units[byte + k] = at;
+        }
+        at += ch.len_utf16();
+    }
+    units[text.len()] = at;
+    units
+}
diff --git a/numbat-wasm/src/lex.rs b/numbat-wasm/src/lex.rs

@@ -0,0 +1,40 @@
+//! Parsing: the syntax tree of a text, as generic data.
+//!
+//! `parse(text)` answers `{"statements":[node,…],"errors":[{"code","message","span"},…]}`. A node is `{"t": kind, "f": {fields}}`
+//! or `{"t": kind, "a": [items]}` (see `reflect.rs`), with every span in UTF-16 units of the text. The statements before an error
+//! are given, and the error, with its position, stands for the statement that could not be read: the tree exists for broken input.
+
+use numbat::parser::parse as numbat_parse;
+use wasm_bindgen::prelude::*;
+
+use crate::json::{J, utf16_offsets};
+use crate::reflect::debug_to_json;
+
+#[wasm_bindgen]
+pub fn parse(text: &str) -> String {
+    let units = utf16_offsets(text);
+    let (statements, errors) = match numbat_parse(text, 0) {
+        Ok(statements) => (statements, Vec::new()),
+        Err((statements, errors)) => (statements, errors),
+    };
+    let nodes: Vec<J> = statements.iter().map(|s| debug_to_json(&format!("{s:?}"), &units)).collect();
+    let errs: Vec<J> = errors
+        .iter()
+        .map(|e| {
+            let start = units[e.span.start.as_usize().min(text.len())];
+            let end = units[e.span.end.as_usize().min(text.len())];
+            J::obj(vec![
+                ("code", kind_of(&format!("{:?}", e.kind))),
+                ("message", J::s(e.to_string())),
+                ("span", J::obj(vec![("start", J::n(start)), ("end", J::n(end))])),
+            ])
+        })
+        .collect();
+    J::obj(vec![("statements", J::Arr(nodes)), ("errors", J::Arr(errs))]).dump()
+}
+
+/// The name of an error kind: `ExpectedPrimary` from `ExpectedPrimary` or `TrailingEqualSign("x")`.
+fn kind_of(debug: &str) -> J {
+    let end = debug.find(['(', ' ', '{']).unwrap_or(debug.len());
+    J::s(&debug[..end])
+}
diff --git a/numbat-wasm/src/reflect.rs b/numbat-wasm/src/reflect.rs
new file mode 100644
index 00000000..51950c6f
--- /dev/null
+++ b/numbat-wasm/src/reflect.rs
@@ -0,0 +1,271 @@
+//! The shape of a Rust value, as data, from its `Debug` text.
+//!
+//! Numbat's syntax tree and typed tree derive `Debug`, and the derived text is regular: a name, then `(…)` or `{ field: value }`,
+//! lists, strings, numbers. Reading that into JSON gives a generic tree (`{"t": name, "f": {fields}}` or `{"t": name, "a":
+//! [items]}`) without a line of code for each kind of node, so a node kind Numbat adds appears in the tree on its own and
+//! nothing is dropped. `Span` becomes `{start, end}` in UTF-16 units. `None` is null and `Some(x)` is `x`.
+
+use crate::json::J;
+
+pub fn debug_to_json(text: &str, units: &[usize]) -> J {
+    let chars: Vec<char> = text.chars().collect();
+    let mut p = Parser { chars: &chars, at: 0, units };
+    p.value()
+}
+
+struct Parser<'a> {
+    chars: &'a [char],
+    at: usize,
+    units: &'a [usize],
+}
+
+impl Parser<'_> {
+    fn peek(&self) -> Option<char> {
+        self.chars.get(self.at).copied()
+    }
+
+    fn skip_space(&mut self) {
+        while self.peek().is_some_and(char::is_whitespace) {
+            self.at += 1;
+        }
+    }
+
+    fn eat(&mut self, c: char) -> bool {
+        self.skip_space();
+        if self.peek() == Some(c) {
+            self.at += 1;
+            true
+        } else {
+            false
+        }
+    }
+
+    fn value(&mut self) -> J {
+        self.skip_space();
+        match self.peek() {
+            None => J::Null,
+            Some('"') => J::Str(self.string()),
+            Some('\'') => J::Str(self.char_literal()),
+            Some('[') => {
+                self.at += 1;
+                J::Arr(self.items(']'))
+            }
+            Some('(') => {
+                self.at += 1;
+                J::Arr(self.items(')'))
+            }
+            Some('{') => {
+                self.at += 1;
+                self.map()
+            }
+            Some(c) if c.is_ascii_digit() || c == '-' => self.number(),
+            Some(_) => self.named(),
+        }
+    }
+
+    fn items(&mut self, close: char) -> Vec<J> {
+        let mut items = Vec::new();
+        loop {
+            if self.eat(close) || self.peek().is_none() {
+                return items;
+            }
+            items.push(self.value());
+            self.eat(',');
+        }
+    }
+
+    /// `{ key: value, … }` of a map (a struct has its name before the brace and is read by `named`).
+    fn map(&mut self) -> J {
+        let mut fields = Vec::new();
+        loop {
+            if self.eat('}') || self.peek().is_none() {
+                return J::Obj(fields);
+            }
+            let key = match self.value() {
+                J::Str(s) => s,
+                other => other.dump(),
+            };
+            self.eat(':');
+            let value = self.value();
+            fields.push((key, value));
+            self.eat(',');
+        }
+    }
+
+    fn number(&mut self) -> J {
+        let start = self.at;
+        if self.peek() == Some('-') {
+            self.at += 1;
+        }
+        while self.peek().is_some_and(|c| c.is_ascii_alphanumeric() || c == '.' || c == '_') {
+            self.at += 1;
+            // an exponent may carry a sign: `1e-9`
+            if matches!(self.chars.get(self.at - 1), Some('e' | 'E'))
+                && matches!(self.peek(), Some('-' | '+'))
+                && self.chars[start..self.at].iter().any(|c| c.is_ascii_digit())
+            {
+                self.at += 1;
+            }
+        }
+        let word: String = self.chars[start..self.at].iter().collect();
+        match word.parse::<f64>() {
+            Ok(n) => J::Num(n),
+            Err(_) => J::Str(word),
+        }
+    }
+
+    fn string(&mut self) -> String {
+        self.at += 1; // the opening quote
+        let mut out = String::new();
+        while let Some(c) = self.peek() {
+            self.at += 1;
+            match c {
+                '"' => break,
+                '\\' => match self.peek() {
+                    Some('n') => {
+                        self.at += 1;
+                        out.push('\n');
+                    }
+                    Some('t') => {
+                        self.at += 1;
+                        out.push('\t');
+                    }
+                    Some('r') => {
+                        self.at += 1;
+                        out.push('\r');
+                    }
+                    Some('u') => {
+                        // \u{1f600}
+                        self.at += 1;
+                        if self.peek() == Some('{') {
+                            self.at += 1;
+                            let mut hex = String::new();
+                            while let Some(h) = self.peek() {
+                                self.at += 1;
+                                if h == '}' {
+                                    break;
+                                }
+                                hex.push(h);
+                            }
+                            if let Some(ch) = u32::from_str_radix(&hex, 16).ok().and_then(char::from_u32) {
+                                out.push(ch);
+                            }
+                        }
+                    }
+                    Some(other) => {
+                        self.at += 1;
+                        out.push(other);
+                    }
+                    None => {}
+                },
+                c => out.push(c),
+            }
+        }
+        out
+    }
+
+    fn char_literal(&mut self) -> String {
+        self.at += 1;
+        let mut out = String::new();
+        while let Some(c) = self.peek() {
+            self.at += 1;
+            match c {
+                '\'' => break,
+                '\\' => {
+                    if let Some(next) = self.peek() {
+                        self.at += 1;
+                        out.push(match next {
+                            'n' => '\n',
+                            't' => '\t',
+                            other => other,
+                        });
+                    }
+                }
+                c => out.push(c),
+            }
+        }
+        out
+    }
+
+    fn name(&mut self) -> String {
+        let start = self.at;
+        while let Some(c) = self.peek() {
+            if c.is_alphanumeric() || c == '_' {
+                self.at += 1;
+            } else if c == ':' && self.chars.get(self.at + 1) == Some(&':') {
+                self.at += 2; // a path: `Foo::Bar`
+            } else {
+                break;
+            }
+        }
+        if self.at == start {
+            self.at += 1; // not something Debug prints: skip it so the reading goes on
+        }
+        self.chars[start..self.at].iter().collect()
+    }
+
+    fn named(&mut self) -> J {
+        let name = self.name();
+        match name.as_str() {
+            "true" => return J::Bool(true),
+            "false" => return J::Bool(false),
+            "None" => return J::Null,
+            "NaN" => return J::Num(f64::NAN),
+            "inf" => return J::Num(f64::INFINITY),
+            _ => {}
+        }
+        self.skip_space();
+        match self.peek() {
+            Some('(') => {
+                self.at += 1;
+                let mut items = self.items(')');
+                if name == "Some" && items.len() == 1 {
+                    return items.remove(0);
+                }
+                J::Obj(vec![("t".into(), J::Str(name)), ("a".into(), J::Arr(items))])
+            }
+            Some('{') => {
+                self.at += 1;
+                let mut fields = Vec::new();
+                loop {
+                    if self.eat('}') || self.peek().is_none() {
+                        break;
+                    }
+                    self.skip_space();
+                    let key = self.name();
+                    self.eat(':');
+                    let value = self.value();
+                    fields.push((key, value));
+                    self.eat(',');
+                }
+                if name == "Span" {
+                    return self.span(&fields);
+                }
+                J::Obj(vec![("t".into(), J::Str(name)), ("f".into(), J::Obj(fields))])
+            }
+            _ => J::Obj(vec![("t".into(), J::Str(name))]),
+        }
+    }
+
+    /// `Span { start: ByteIndex(4), end: ByteIndex(5), … }` as `{start, end}` in UTF-16 units.
+    fn span(&self, fields: &[(String, J)]) -> J {
+        let byte = |key: &str| -> usize {
+            let found = fields.iter().find(|(k, _)| k == key).map(|(_, v)| v);
+            // ByteIndex(n) is read as a tuple variant with one number
+            let raw = match found {
+                Some(J::Obj(o)) => o.iter().find(|(k, _)| k == "a").and_then(|(_, a)| match a {
+                    J::Arr(items) => items.first().cloned(),
+                    _ => None,
+                }),
+                Some(other) => Some(other.clone()),
+                None => None,
+            };
+            match raw {
+                Some(J::Num(n)) => n as usize,
+                _ => 0,
+            }
+        };
+        let to_units = |b: usize| self.units.get(b.min(self.units.len() - 1)).copied().unwrap_or(0);
+        J::obj(vec![("start", J::n(to_units(byte("start")))), ("end", J::n(to_units(byte("end"))))])
+    }
+}
diff --git a/numbat-wasm/src/schema.rs b/numbat-wasm/src/schema.rs
new file mode 100644
index 00000000..41ab897c
--- /dev/null
+++ b/numbat-wasm/src/schema.rs
@@ -0,0 +1,37 @@
+//! The schema: what the runtime says about its own language, so nothing is copied into the app.
+
+use numbat::tokenizer::keyword_table;
+use wasm_bindgen::prelude::*;
+
+use crate::json::J;
+
+/// The version of this module's answers; the app checks it against the one it was written for.
+pub const SCHEMA_VERSION: u32 = 1;
+
+/// `{"version", "prefixes":[{long, short, binary, exponent},…], "keywords":[[word, tokenKind],…]}`.
+#[wasm_bindgen]
+pub fn schema() -> String {
+    let mut keywords: Vec<(&str, String)> =
+        keyword_table().iter().map(|(word, kind)| (*word, format!("{kind:?}"))).collect();
+    keywords.sort();
+    let prefixes = numbat::tables::prefix_table()
+        .into_iter()
+        .map(|p| {
+            J::obj(vec![
+                ("long", J::s(p.long)),
+                ("short", J::Arr(p.short.iter().map(|s| J::s(*s)).collect())),
+                ("binary", J::Bool(p.binary)),
+                ("exponent", J::Num(p.exponent as f64)),
+            ])
+        })
+        .collect();
+    J::obj(vec![
+        ("version", J::n(SCHEMA_VERSION as usize)),
+        ("prefixes", J::Arr(prefixes)),
+        (
+            "keywords",
+            J::Arr(keywords.into_iter().map(|(w, k)| J::Arr(vec![J::s(w), J::s(k)])).collect()),
+        ),
+    ])
+    .dump()
+}
diff --git a/numbat-wasm/src/tables.rs b/numbat-wasm/src/tables.rs
new file mode 100644
index 00000000..81bf28f0
--- /dev/null
+++ b/numbat-wasm/src/tables.rs
@@ -0,0 +1,158 @@
+//! The tables of names, as data.
+//!
+//! `Numbat.symbols()` is every name the environment holds in one answer (what it is, its type, where it was defined, what a unit
+//! name accepts for a prefix), and `Numbat.symbol(name)` is one name in full (its name, description, url, aliases, examples; a
+//! function's signature; what a unit is a multiple of; what a dimension is made of). See `numbat/src/tables.rs`.
+
+use numbat::tables::{Symbol, SymbolDetail, SymbolKind, SymbolScope};
+use wasm_bindgen::prelude::*;
+
+use crate::eval::source_json;
+use crate::json::J;
+use crate::types::scheme_json;
+use crate::Numbat;
+
+fn kind_name(kind: SymbolKind) -> &'static str {
+    match kind {
+        SymbolKind::Variable => "variable",
+        SymbolKind::Function => "function",
+        SymbolKind::Unit => "unit",
+        SymbolKind::Dimension => "dimension",
+        SymbolKind::Struct => "struct",
+        SymbolKind::Predefined => "predefined",
+    }
+}
+
+fn symbol_fields(numbat: &Numbat, s: &Symbol) -> Vec<(&'static str, J)> {
+    let registry = numbat.ctx.dimension_registry();
+    let mut fields = vec![
+        ("name", J::s(s.name.as_str())),
+        ("kind", J::s(kind_name(s.kind))),
+        ("type", J::opt(s.scheme.as_ref().map(|t| scheme_json(t, registry)))),
+    ];
+    if let Some(def) = &s.definition {
+        fields.push(("source", source_json(&numbat.ctx.code_source(def.code_source_id))));
+    }
+    if let Some(u) = &s.unit {
+        fields.push((
+            "unit",
+            J::obj(vec![
+                ("canonical", J::s(u.canonical.as_str())),
+                ("longPrefixes", J::Bool(u.long_prefixes)),
+                ("shortPrefixes", J::Bool(u.short_prefixes)),
+                ("metric", J::Bool(u.metric)),
+                ("binary", J::Bool(u.binary)),
+            ]),
+        ));
+    }
+    fields
+}
+
+fn detail_json(numbat: &Numbat, d: &SymbolDetail) -> J {
+    let mut fields = symbol_fields(numbat, &d.symbol);
+    if let Some(def) = &d.symbol.definition {
+        // (the span is in the source it names; the app reads it with the source)
+        fields.push(("definition", J::obj(vec![("start", J::n(def.start.as_usize())), ("end", J::n(def.end.as_usize()))])));
+    }
+    fields.push(("displayName", J::opt(d.display_name.as_ref().map(|s| J::s(s.as_str())))));
+    fields.push(("description", J::opt(d.description.as_ref().map(|s| J::s(s.as_str())))));
+    fields.push(("url", J::opt(d.url.as_ref().map(|s| J::s(s.as_str())))));
+    fields.push(("aliases", J::Arr(d.aliases.iter().map(|a| J::s(a.as_str())).collect())));
+    fields.push((
+        "examples",
+        J::Arr(
+            d.examples
+                .iter()
+                .map(|(code, note)| {
+                    J::obj(vec![("code", J::s(code.as_str())), ("note", J::opt(note.as_ref().map(|n| J::s(n.as_str()))))])
+                })
+                .collect(),
+        ),
+    ));
+    if let Some(f) = &d.function {
+        fields.push((
+            "function",
+            J::obj(vec![
+                (
+                    "typeParameters",
+                    J::Arr(
+                        f.type_parameters
+                            .iter()
+                            .map(|(n, bound)| J::obj(vec![("name", J::s(n.as_str())), ("dimensionBound", J::Bool(*bound))]))
+                            .collect(),
+                    ),
+                ),
+                (
+                    "parameters",
+                    J::Arr(
+                        f.parameters
+                            .iter()
+                            .map(|p| {
+                                J::obj(vec![
+                                    ("name", J::s(p.name.as_str())),
+                                    ("annotation", J::opt(p.annotation.as_ref().map(J::s))),
+                                    ("readable", J::s(p.readable.as_str())),
+                                ])
+                            })
+                            .collect(),
+                    ),
+                ),
+                ("returnsAnnotation", J::opt(f.returns_annotation.as_ref().map(J::s))),
+                ("returnsReadable", J::s(f.returns_readable.as_str())),
+            ]),
+        ));
+    }
+    if let Some(u) = &d.unit {
+        fields.push((
+            "unitDetail",
+            J::obj(vec![
+                ("canonical", J::s(u.canonical.as_str())),
+                ("dimension", J::s(u.dimension.as_str())),
+                ("dimensionless", J::Bool(u.dimensionless)),
+                (
+                    "prefix",
+                    J::opt(u.prefix.as_ref().map(|(factor, of)| {
+                        J::obj(vec![("factor", J::Num(*factor)), ("of", J::s(of.as_str()))])
+                    })),
+                ),
+                (
+                    "definedBy",
+                    J::opt(u.defined_by.as_ref().map(|(factor, unit)| {
+                        J::obj(vec![("factor", J::Num(*factor)), ("unit", J::s(unit.as_str()))])
+                    })),
+                ),
+                ("isBase", J::Bool(u.is_base)),
+            ]),
+        ));
+    }
+    if let Some(dim) = &d.dimension {
+        fields.push((
+            "dimensionDetail",
+            J::obj(vec![
+                ("isBase", J::Bool(dim.is_base)),
+                ("definition", J::opt(dim.definition.as_ref().map(J::s))),
+                ("equivalents", J::Arr(dim.equivalents.iter().map(|e| J::s(e.as_str())).collect())),
+                ("units", J::Arr(dim.units.iter().map(|u| J::s(u.as_str())).collect())),
+            ]),
+        ));
+    }
+    J::obj(fields)
+}
+
+#[wasm_bindgen]
+impl Numbat {
+    /// Every name of one scope, as a JSON array: `document` (what the sheet's lines define, and every dimension) or `library`
+    /// (the language's names and those of the modules imported).
+    pub fn symbols(&self, scope: &str) -> String {
+        let scope = if scope == "document" { SymbolScope::Document } else { SymbolScope::Library };
+        J::Arr(self.ctx.symbols(scope).iter().map(|s| J::obj(symbol_fields(self, s))).collect()).dump()
+    }
+
+    /// One name in full, as JSON, or `null`.
+    pub fn symbol(&self, name: &str) -> String {
+        match self.ctx.symbol_detail(name) {
+            Some(d) => detail_json(self, &d).dump(),
+            None => "null".to_string(),
+        }
+    }
+}
diff --git a/numbat-wasm/src/types.rs b/numbat-wasm/src/types.rs
new file mode 100644
index 00000000..008cedd0
--- /dev/null
+++ b/numbat-wasm/src/types.rs
@@ -0,0 +1,122 @@
+//! Types as data: what the typechecker says a thing is.
+//!
+//! `{"t":"dimension","factors":[{"name":"Length","exp":1}],"text":"Length"}`, `bool`, `string`, `datetime`, `fn`
+//! (`params`, `ret`), `struct` (`name`, `args`, `fields`), `list` (`elem`), `var` (an unsolved or quantified type variable) and
+//! `forall` (`inner`, `bounds`): every form of Numbat's `Type`, with the readable text beside it (`Length / Time`).
+
+use numbat::markup::{Formatter, PlainTextFormatter};
+use numbat::{Bound, DType, DTypeFactor, QualifiedType, StructInfo, StructKind, Type, TypeScheme, TypeVariable};
+
+use crate::json::J;
+
+fn plain(markup: &numbat::markup::Markup) -> String {
+    PlainTextFormatter {}.format(markup, false).to_string()
+}
+
+fn exponent(numer: i128, denom: i128) -> J {
+    if denom == 1 { J::Num(numer as f64) } else { J::Num(numer as f64 / denom as f64) }
+}
+
+fn variable(v: &TypeVariable) -> J {
+    match v {
+        TypeVariable::Named(name) => J::obj(vec![("t", J::s("var")), ("name", J::s(name.as_str()))]),
+        TypeVariable::Quantified(i) => J::obj(vec![("t", J::s("var")), ("index", J::n(*i))]),
+    }
+}
+
+fn dimension(d: &DType, text: String) -> J {
+    let factors = d
+        .factors()
+        .iter()
+        .map(|(factor, exp)| {
+            let (kind, name) = match factor {
+                DTypeFactor::TVar(TypeVariable::Named(name)) => ("var", name.to_string()),
+                DTypeFactor::TVar(TypeVariable::Quantified(i)) => ("var", format!("#{i}")),
+                DTypeFactor::TPar(name) => ("parameter", name.to_string()),
+                DTypeFactor::BaseDimension(name) => ("base", name.to_string()),
+            };
+            J::obj(vec![
+                ("kind", J::s(kind)),
+                ("name", J::s(name)),
+                ("exp", exponent(*exp.numer(), *exp.denom())),
+            ])
+        })
+        .collect();
+    J::obj(vec![("t", J::s("dimension")), ("factors", J::Arr(factors)), ("text", J::s(text))])
+}
+
+fn struct_json(info: &StructInfo, registry: &numbat::dimension::DimensionRegistry) -> J {
+    let args = match &info.kind {
+        StructKind::Instance(args) => args.iter().map(|a| type_json(a, registry)).collect(),
+        StructKind::Definition(_) => Vec::new(),
+    };
+    let fields = info
+        .fields
+        .iter()
+        .map(|(name, (_, ty))| J::obj(vec![("name", J::s(name.as_str())), ("type", type_json(ty, registry))]))
+        .collect();
+    J::obj(vec![
+        ("t", J::s("struct")),
+        ("name", J::s(info.name.as_str())),
+        ("args", J::Arr(args)),
+        ("fields", J::Arr(fields)),
+    ])
+}
+
+pub fn type_json(ty: &Type, registry: &numbat::dimension::DimensionRegistry) -> J {
+    match ty {
+        Type::TVar(v) => variable(v),
+        Type::TPar(name) => J::obj(vec![("t", J::s("parameter")), ("name", J::s(name.as_str()))]),
+        // (a quantified variable cannot be written by Numbat's own printer: the factors are written out instead)
+        Type::Dimension(d) if d.factors().iter().any(|(f, _)| matches!(f, DTypeFactor::TVar(TypeVariable::Quantified(_)))) => {
+            let text = d
+                .factors()
+                .iter()
+                .map(|(factor, exp)| {
+                    let name = match factor {
+                        DTypeFactor::TVar(TypeVariable::Quantified(i)) => format!("T{i}"),
+                        other => other.name().to_string(),
+                    };
+                    if *exp.numer() == 1 && *exp.denom() == 1 { name } else { format!("{name}^{exp}") }
+                })
+                .collect::<Vec<_>>()
+                .join(" × ");
+            dimension(d, text)
+        }
+        Type::Dimension(d) => dimension(d, plain(&ty.to_readable_type(registry))),
+        Type::Boolean => J::obj(vec![("t", J::s("bool"))]),
+        Type::String => J::obj(vec![("t", J::s("string"))]),
+        Type::DateTime => J::obj(vec![("t", J::s("datetime"))]),
+        Type::Fn(params, ret) => J::obj(vec![
+            ("t", J::s("fn")),
+            ("params", J::Arr(params.iter().map(|p| type_json(p, registry)).collect())),
+            ("ret", type_json(ret, registry)),
+        ]),
+        Type::Struct(info) => struct_json(info, registry),
+        Type::List(elem) => J::obj(vec![("t", J::s("list")), ("elem", type_json(elem, registry))]),
+    }
+}
+
+pub fn scheme_json(scheme: &TypeScheme, registry: &numbat::dimension::DimensionRegistry) -> J {
+    match scheme {
+        TypeScheme::Concrete(ty) => type_json(ty, registry),
+        // nothing quantified and nothing bounded is the type itself
+        TypeScheme::Quantified(0, QualifiedType { inner, bounds }) if bounds.is_empty() => type_json(inner, registry),
+        TypeScheme::Quantified(count, QualifiedType { inner, bounds }) => J::obj(vec![
+            ("t", J::s("forall")),
+            ("count", J::n(*count)),
+            ("inner", type_json(inner, registry)),
+            (
+                "bounds",
+                J::Arr(
+                    bounds
+                        .iter()
+                        .map(|b| match b {
+                            Bound::IsDim(ty) => type_json(ty, registry),
+                        })
+                        .collect(),
+                ),
+            ),
+        ]),
+    }
+}
diff --git a/numbat-wasm/src/values.rs b/numbat-wasm/src/values.rs
new file mode 100644
index 00000000..18722d31
--- /dev/null
+++ b/numbat-wasm/src/values.rs
@@ -0,0 +1,72 @@
+//! Values as data: what an evaluation gave.
+//!
+//! `{"t":"quantity","number":3,"unit":"m","text":"3 m"}` (a conversion asked for as a multiple of a unit, `6 hours -> 45 min`, adds
+//! `target`), `bool`, `string`, `datetime`, `function`, `format`, `struct` (`name`, `fields`) and `list` (`items`); every one has
+//! the `text` it is printed as, to twelve significant digits.
+
+use numbat::markup::{Formatter, PlainTextFormatter};
+use numbat::value::Value;
+use numbat::FormatOptions;
+
+use crate::json::J;
+
+pub fn options() -> FormatOptions {
+    FormatOptions { significant_digits: 12, ..FormatOptions::default() }
+}
+
+fn plain(markup: &numbat::markup::Markup) -> String {
+    PlainTextFormatter {}.format(markup, false).to_string()
+}
+
+pub fn value_json(value: &Value) -> J {
+    let text = J::s(plain(&value.pretty_print_with(&options())));
+    match value {
+        Value::Quantity(q) => {
+            let mut fields = vec![
+                ("t", J::s("quantity")),
+                ("number", J::Num(q.unsafe_value().to_f64())),
+                ("unit", J::s(q.unit().to_string())),
+            ];
+            if let Some(target) = q.conversion_target() {
+                // shown as `coefficient × target`: the number is the coefficient, the unit is the target's
+                let coefficient = q.unsafe_value().to_f64() / target.unsafe_value().to_f64();
+                fields[1] = ("number", J::Num(coefficient));
+                fields[2] = ("unit", J::s(target.unit().to_string()));
+                fields.push((
+                    "target",
+                    J::obj(vec![
+                        ("number", J::Num(target.unsafe_value().to_f64())),
+                        ("unit", J::s(target.unit().to_string())),
+                    ]),
+                ));
+            }
+            fields.push(("text", text));
+            J::obj(fields)
+        }
+        Value::Boolean(b) => J::obj(vec![("t", J::s("bool")), ("value", J::Bool(*b)), ("text", text)]),
+        Value::String(s) => J::obj(vec![("t", J::s("string")), ("value", J::s(s.as_str())), ("text", text)]),
+        Value::DateTime(_) => J::obj(vec![("t", J::s("datetime")), ("text", text)]),
+        Value::FunctionReference(_) => J::obj(vec![("t", J::s("function")), ("text", text)]),
+        Value::FormatSpecifiers(_) => J::obj(vec![("t", J::s("format")), ("text", text)]),
+        Value::StructInstance(info, values) => J::obj(vec![
+            ("t", J::s("struct")),
+            ("name", J::s(info.name.as_str())),
+            (
+                "fields",
+                J::Arr(
+                    info.fields
+                        .keys()
+                        .zip(values.iter())
+                        .map(|(name, v)| J::obj(vec![("name", J::s(name.as_str())), ("value", value_json(v))]))
+                        .collect(),
+                ),
+            ),
+            ("text", text),
+        ]),
+        Value::List(list) => J::obj(vec![
+            ("t", J::s("list")),
+            ("items", J::Arr(list.iter().map(value_json).collect())),
+            ("text", text),
+        ]),
+    }
+}

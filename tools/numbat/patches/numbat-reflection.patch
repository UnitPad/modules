+/// The text of a module, kept for the life of the process, once for each distinct text (UnitPad patch).
+///
+/// The parsed program borrows its source (`Statement<'a>`), and the resolver hands programs back, so the source of an imported
+/// module has to outlive the resolver: upstream leaks a fresh copy of it each time a module is imported, and every `Context` that
+/// loads the prelude imports all of it, so each one left the whole library's text (about 93 KB) behind when dropped. Modules come
+/// from a fixed set, so a copy kept for each distinct text is bounded by the size of the library, however many contexts there are.
+fn leak_once(code: &str) -> &'static str {
+    use std::collections::HashSet;
+    use std::sync::{Mutex, OnceLock};
+    static KEPT: OnceLock<Mutex<HashSet<&'static str>>> = OnceLock::new();
+    let mut kept = KEPT.get_or_init(Default::default).lock().unwrap();
+    if let Some(found) = kept.get(code) {
+        return found;
+    }
+    let leaked: &'static str = Box::leak(code.to_string().into_boxed_str());
+    kept.insert(leaked);
+    leaked
+}

diff --git a/numbat/src/tables.rs b/numbat/src/tables.rs
new file mode 100644
index 00000000..240bf6fb
--- /dev/null
+++ b/numbat/src/tables.rs
@@ -0,0 +1,380 @@
+//! UnitPad patch: the runtime's tables of names, readable.
+//!
+//! What is defined (variables, functions, units, dimensions), what each is (its type), where it was defined, and for the ones
+//! that carry it, what they say about themselves (name, description, url, aliases, examples; a function's signature; what a unit
+//! is a multiple of; what a dimension is made of). All of it is read from the tables the interpreter itself uses, none of it from
+//! the text `print_info` writes.
+
+use compact_str::CompactString;
+
+use crate::{
+    Context, Type,
+    markup::{Formatter, Markup, PlainTextFormatter},
+    interpreter::Interpreter,
+    prefix_parser::PrefixParserResult,
+    pretty_print::PrettyPrint,
+    resolver::CodeSource,
+    span::Span,
+    typechecker::{environment::IdentifierKind, type_scheme::TypeScheme},
+    unit::BaseUnitAndFactor,
+};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SymbolKind {
+    Variable,
+    Function,
+    Unit,
+    Dimension,
+    /// A struct: its type is the struct, with its fields.
+    Struct,
+    /// `ans` and `_`, which the language defines.
+    Predefined,
+}
+
+/// What a unit name accepts: it is one alias of a unit, and the unit may take prefixes written in full (`kilometre`), short
+/// (`km`), metric and binary.
+#[derive(Debug, Clone)]
+pub struct UnitFacts {
+    pub canonical: CompactString,
+    pub long_prefixes: bool,
+    pub short_prefixes: bool,
+    pub metric: bool,
+    pub binary: bool,
+}
+
+/// One name of the tables.
+#[derive(Debug, Clone)]
+pub struct Symbol {
+    pub name: CompactString,
+    pub kind: SymbolKind,
+    pub scheme: Option<TypeScheme>,
+    pub definition: Option<Span>,
+    pub unit: Option<UnitFacts>,
+}
+
+#[derive(Debug, Clone)]
+pub struct ParameterDetail {
+    pub name: CompactString,
+    /// The type as the author wrote it, if they wrote one.
+    pub annotation: Option<String>,
+    /// The type as Numbat reads it, written out.
+    pub readable: String,
+}
+
+#[derive(Debug, Clone)]
+pub struct FunctionDetail {
+    /// Type parameters, and whether each is bound to be a dimension (`<D: Dim>`).
+    pub type_parameters: Vec<(CompactString, bool)>,
+    pub parameters: Vec<ParameterDetail>,
+    pub returns_annotation: Option<String>,
+    pub returns_readable: String,
+}
+
+#[derive(Debug, Clone)]
+pub struct UnitDetail {
+    /// The unit's full name (the one its aliases stand for).
+    pub canonical: CompactString,
+    /// The dimension of the unit, as Numbat writes it (`Length`).
+    pub dimension: String,
+    pub dimensionless: bool,
+    /// What a prefixed name is: the prefix's factor and the unit it is a prefix of.
+    pub prefix: Option<(f64, CompactString)>,
+    /// What one of the unit is, in the unit it is defined by (`1 kilometre = 1000 metre`), if it is defined by one.
+    pub defined_by: Option<(f64, String)>,
+    pub is_base: bool,
+}
+
+#[derive(Debug, Clone)]
+pub struct DimensionDetail {
+    pub is_base: bool,
+    /// What it is made of, when it is not a base dimension.
+    pub definition: Option<String>,
+    /// The other names for the same dimension.
+    pub equivalents: Vec<CompactString>,
+    /// The units of the dimension, by their first alias.
+    pub units: Vec<CompactString>,
+}
+
+/// One name, in full.
+#[derive(Debug, Clone)]
+pub struct SymbolDetail {
+    pub symbol: Symbol,
+    pub display_name: Option<CompactString>,
+    pub description: Option<CompactString>,
+    pub url: Option<CompactString>,
+    pub aliases: Vec<CompactString>,
+    pub examples: Vec<(CompactString, Option<CompactString>)>,
+    pub source: Option<CodeSource>,
+    pub function: Option<FunctionDetail>,
+    pub unit: Option<UnitDetail>,
+    pub dimension: Option<DimensionDetail>,
+}
+
+fn plain(markup: &Markup) -> String {
+    PlainTextFormatter {}.format(markup, false).to_string()
+}
+
+/// Which names a table is of: the sheet's (defined by its lines, and every dimension: the ones a sheet declares have no source),
+/// or the rest (the library's and the imported modules'), which change only when the set of imports does.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SymbolScope {
+    Document,
+    Library,
+}
+
+impl Context {
+    fn is_document(&self, definition: Option<Span>) -> bool {
+        match definition.map(|span| self.resolver.get_code_source(span.code_source_id)) {
+            Some(CodeSource::Text) => true,
+            Some(CodeSource::File(path)) => path.to_string_lossy().starts_with("line:"),
+            _ => false,
+        }
+    }
+
+    /// Every name of one scope: what is defined, what each is, where it was defined.
+    pub fn symbols(&self, scope: SymbolScope) -> Vec<Symbol> {
+        let mut out: Vec<Symbol> = Vec::new();
+        let units: std::collections::HashMap<&CompactString, _> =
+            self.prefix_transformer.prefix_parser.unit_infos().collect();
+        for (name, kind) in self.typechecker.entries() {
+            let (symbol_kind, scheme, definition) = match kind {
+                IdentifierKind::Normal(scheme, span, true) => (SymbolKind::Unit, scheme, Some(*span)),
+                IdentifierKind::Normal(scheme, span, false) => (SymbolKind::Variable, scheme, Some(*span)),
+                IdentifierKind::Function(signature, _) => {
+                    (SymbolKind::Function, &signature.fn_type, Some(signature.definition_span))
+                }
+                IdentifierKind::Predefined(scheme) => (SymbolKind::Predefined, scheme, None),
+            };
+            if (scope == SymbolScope::Document) != self.is_document(definition) {
+                continue;
+            }
+            let unit = units.get(name).map(|info| UnitFacts {
+                canonical: info.full_name.clone(),
+                long_prefixes: info.accepts_prefix.long,
+                short_prefixes: info.accepts_prefix.short,
+                metric: info.metric_prefixes,
+                binary: info.binary_prefixes,
+            });
+            out.push(Symbol {
+                name: name.clone(),
+                kind: symbol_kind,
+                scheme: Some(scheme.clone()),
+                definition,
+                unit,
+            });
+        }
+        for info in self.typechecker.struct_infos() {
+            let definition = Some(info.definition_span);
+            if (scope == SymbolScope::Document) != self.is_document(definition) {
+                continue;
+            }
+            out.push(Symbol {
+                name: info.name.clone(),
+                kind: SymbolKind::Struct,
+                scheme: Some(TypeScheme::concrete(Type::Struct(Box::new(info.clone())))),
+                definition,
+                unit: None,
+            });
+        }
+        if scope == SymbolScope::Document {
+            for name in self.dimension_registry().names() {
+                out.push(Symbol { name, kind: SymbolKind::Dimension, scheme: None, definition: None, unit: None });
+            }
+        }
+        out
+    }
+
+    /// One name in full, or `None` when the tables do not hold it. A unit written with a prefix (`km`) is told as the unit it
+    /// prefixes, with the prefix.
+    pub fn symbol_detail(&self, name: &str) -> Option<SymbolDetail> {
+        let registry = self.dimension_registry();
+
+        // A function.
+        if let Some((signature, metadata)) = self.typechecker.lookup_function(name) {
+            let (fn_type, type_parameters) = signature.fn_type.instantiate_for_printing(Some(
+                signature.type_parameters.iter().map(|(_, n, _)| n.as_str()),
+            ));
+            let Type::Fn(parameter_types, return_type) = &fn_type.inner else {
+                return None;
+            };
+            let parameters = signature
+                .parameters
+                .iter()
+                .zip(parameter_types)
+                .map(|((_, pname, annotation), ty)| ParameterDetail {
+                    name: pname.clone(),
+                    annotation: annotation.as_ref().map(|a| plain(&a.pretty_print())),
+                    readable: plain(&ty.to_readable_type(registry)),
+                })
+                .collect();
+            let _ = type_parameters;
+            return Some(SymbolDetail {
+                symbol: Symbol {
+                    name: name.into(),
+                    kind: SymbolKind::Function,
+                    scheme: Some(signature.fn_type.clone()),
+                    definition: Some(signature.definition_span),
+                    unit: None,
+                },
+                display_name: metadata.name.clone(),
+                description: metadata.description.clone(),
+                url: metadata.url.clone(),
+                aliases: Vec::new(),
+                examples: metadata.examples.clone(),
+                source: Some(self.resolver.get_code_source(signature.definition_span.code_source_id)),
+                function: Some(FunctionDetail {
+                    type_parameters: signature
+                        .type_parameters
+                        .iter()
+                        .map(|(_, n, bound)| (n.clone(), bound.is_some()))
+                        .collect(),
+                    parameters,
+                    returns_annotation: signature.return_type_annotation.as_ref().map(|a| plain(&a.pretty_print())),
+                    returns_readable: plain(&return_type.to_readable_type(registry)),
+                }),
+                unit: None,
+                dimension: None,
+            });
+        }
+
+        // A unit, with or without a prefix.
+        if let PrefixParserResult::UnitIdentifier(span, prefix, _written, full_name) =
+            self.prefix_transformer.prefix_parser.parse(name)
+        {
+            let reg = self.interpreter.get_unit_registry();
+            if let Ok((_, md)) = reg.inner.get_base_representation_for_name(&full_name) {
+                let defined_by = self.interpreter.get_defining_unit(&full_name).and_then(|defining| {
+                    defining
+                        .iter()
+                        .filter(|u| !u.unit_id.is_base())
+                        .map(|f| f.unit_id.unit_and_factor())
+                        .next()
+                        .map(|BaseUnitAndFactor(unit, factor)| {
+                            (
+                                factor.to_f64(),
+                                plain(&unit.pretty_print_with(|f| f.exponent, 'x', '/', true, Some(crate::markup::FormatType::Unit))),
+                            )
+                        })
+                });
+                return Some(SymbolDetail {
+                    symbol: Symbol {
+                        name: name.into(),
+                        kind: SymbolKind::Unit,
+                        scheme: self.typechecker.lookup_identifier_type(&full_name),
+                        definition: Some(span),
+                        unit: None,
+                    },
+                    display_name: md.name.clone(),
+                    description: md.description.clone(),
+                    url: md.url.clone(),
+                    aliases: md.aliases.iter().map(|(a, _)| a.clone()).collect(),
+                    examples: Vec::new(),
+                    source: Some(self.resolver.get_code_source(span.code_source_id)),
+                    function: None,
+                    unit: Some(UnitDetail {
+                        canonical: full_name.clone(),
+                        dimension: plain(&md.readable_type),
+                        dimensionless: matches!(&md.type_, Type::Dimension(d) if d.is_scalar()),
+                        prefix: if prefix == crate::prefix::Prefix::none() {
+                            None
+                        } else {
+                            Some((prefix.factor().to_f64(), full_name.clone()))
+                        },
+                        defined_by,
+                        is_base: reg.inner.is_base_unit(&full_name),
+                    }),
+                    dimension: None,
+                });
+            }
+        }
+
+        // A dimension.
+        if registry.contains(name) {
+            let base = registry.get_base_representation_for_name(name).ok();
+            let is_base = registry.is_base_dimension(name);
+            let equivalents = base
+                .as_ref()
+                .map(|b| registry.get_derived_entry_names_for(b).into_iter().filter(|n| n.as_str() != name).collect())
+                .unwrap_or_default();
+            let mut units: Vec<CompactString> = match &base {
+                Some(b) => self
+                    .unit_representations()
+                    .filter_map(|(_, (_, md))| match &md.type_ {
+                        Type::Dimension(d) if &d.to_base_representation() == b => md.aliases.first().map(|(a, _)| a.clone()),
+                        _ => None,
+                    })
+                    .collect(),
+                None => Vec::new(),
+            };
+            units.sort_by_key(|u| u.to_lowercase());
+            return Some(SymbolDetail {
+                symbol: Symbol { name: name.into(), kind: SymbolKind::Dimension, scheme: None, definition: None, unit: None },
+                display_name: None,
+                description: None,
+                url: None,
+                aliases: Vec::new(),
+                examples: Vec::new(),
+                source: None,
+                function: None,
+                unit: None,
+                dimension: Some(DimensionDetail {
+                    is_base,
+                    definition: if is_base { None } else { base.map(|b| plain(&b.pretty_print())) },
+                    equivalents,
+                    units,
+                }),
+            });
+        }
+
+        // A variable (or constant).
+        if let Some(local) = self.interpreter.lookup_global(name) {
+            let definition = match self.typechecker.entries().find(|(n, _)| n.as_str() == name) {
+                Some((_, IdentifierKind::Normal(_, span, _))) => Some(*span),
+                _ => None,
+            };
+            return Some(SymbolDetail {
+                symbol: Symbol {
+                    name: name.into(),
+                    kind: SymbolKind::Variable,
+                    scheme: self.typechecker.lookup_identifier_type(name),
+                    definition,
+                    unit: None,
+                },
+                display_name: local.metadata.name.clone(),
+                description: local.metadata.description.clone(),
+                url: local.metadata.url.clone(),
+                aliases: local.metadata.aliases.iter().cloned().collect(),
+                examples: Vec::new(),
+                source: definition.map(|s| self.resolver.get_code_source(s.code_source_id)),
+                function: None,
+                unit: None,
+                dimension: None,
+            });
+        }
+        None
+    }
+}
+
+/// A unit prefix: its name in full, the short forms, whether it is binary (else metric) and the exponent (of 10, or of 2).
+#[derive(Debug, Clone)]
+pub struct PrefixRow {
+    pub long: &'static str,
+    pub short: &'static [&'static str],
+    pub binary: bool,
+    pub exponent: i32,
+}
+
+/// The prefixes the language knows (`kilo`/`k`, `mebi`/`Mi`, …).
+pub fn prefix_table() -> Vec<PrefixRow> {
+    crate::prefix_parser::PrefixParser::prefixes()
+        .iter()
+        .map(|(long, short, prefix)| PrefixRow {
+            long,
+            short,
+            binary: matches!(prefix, crate::prefix::Prefix::Binary(_)),
+            exponent: match prefix {
+                crate::prefix::Prefix::Metric(e) | crate::prefix::Prefix::Binary(e) => *e,
+            },
+        })
+        .collect()
+}

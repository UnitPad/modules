index 00000000..ce20141b
--- /dev/null
+++ b/numbat-wasm/src/lex.rs
@@ -0,0 +1,73 @@
+//! Lexing: the tokens of a text, and what is between them.
+//!
+//! `lex(text)` tokenizes each line with Numbat's own tokenizer (a line is where an error stops: the lines after it are still
+//! read) and answers, in UTF-16 units of the whole text:
+//! `{"tokens":[[kind,start,end],…],"trivia":[[kind,start,end],…],"errors":[[start,end,kind],…]}`.
+//! `kind` is Numbat's `TokenKind`; trivia is `whitespace` and `comment` (a comment runs to the end of its line).
+
+use numbat::tokenizer::{TokenKind, tokenize};
+use wasm_bindgen::prelude::*;
+
+use crate::json::{J, utf16_offsets};
+
+/// The name of a token kind: `IntegerWithBase` for `IntegerWithBase(16)`.
+fn kind_name(kind: TokenKind) -> String {
+    let debug = format!("{kind:?}");
+    debug.split('(').next().unwrap_or("").to_string()
+}
+
+#[wasm_bindgen]
+pub fn lex(text: &str) -> String {
+    let units = utf16_offsets(text);
+    let mut tokens = Vec::new();
+    let mut trivia = Vec::new();
+    let mut errors = Vec::new();
+    let mut line_start = 0usize;
+    for line in text.split('\n') {
+        let line_end = line_start + line.len();
+        match tokenize(line, 0) {
+            Ok(list) => {
+                let mut covered = 0usize; // bytes of the line accounted for
+                for token in list.iter().filter(|t| t.kind != TokenKind::Eof) {
+                    let start = token.span.start.as_usize().min(line.len());
+                    let end = (start + token.lexeme.len()).min(line.len());
+                    trivia_between(line, covered, start, line_start, &units, &mut trivia);
+                    tokens.push(J::Arr(vec![
+                        J::s(kind_name(token.kind)),
+                        J::n(units[line_start + start]),
+                        J::n(units[line_start + end]),
+                    ]));
+                    covered = end;
+                }
+                trivia_between(line, covered, line.len(), line_start, &units, &mut trivia);
+            }
+            Err(e) => {
+                let start = e.span.start.as_usize().min(line.len());
+                let end = (e.span.end.as_usize() + 1).min(line.len()).max(start);
+                errors.push(J::Arr(vec![
+                    J::n(units[line_start + start]),
+                    J::n(units[line_start + end]),
+                    J::s(format!("{:?}", e.kind)),
+                ]));
+            }
+        }
+        line_start = line_end + 1;
+    }
+    J::obj(vec![("tokens", J::Arr(tokens)), ("trivia", J::Arr(trivia)), ("errors", J::Arr(errors))]).dump()
+}
+
+/// The whitespace and the comment in `line[from..to]`, which no token covers.
+fn trivia_between(line: &str, from: usize, to: usize, line_start: usize, units: &[usize], out: &mut Vec<J>) {
+    let mut at = from;
+    while at < to {
+        let rest = &line[at..to];
+        let (kind, len) = if rest.starts_with('#') {
+            ("comment", rest.len())
+        } else {
+            let len = rest.find('#').unwrap_or(rest.len());
+            ("whitespace", len)
+        };
+        out.push(J::Arr(vec![J::s(kind), J::n(units[line_start + at]), J::n(units[line_start + at + len])]));
+        at += len;
+    }
+}

new file mode 100644
index 00000000..cddc3e7c
--- /dev/null
+++ b/numbat/src/facts.rs
@@ -0,0 +1,119 @@
+//! UnitPad patch: facts the real phases state as they work, so the app reads what the runtime did instead of guessing it again.
+//!
+//! The typechecker records every name it resolves (what it is, and where it was defined), and the functions that read the clock or
+//! the exchange rates note it, so a line's result can say what it depends on from outside. Nothing here changes what is computed.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use compact_str::CompactString;
+
+use crate::{prefix::Prefix, span::Span};
+
+/// What a name turned out to be where it was used.
+#[derive(Debug, Clone)]
+pub enum UseKind {
+    Variable,
+    Function,
+    /// A unit, with the prefix it was written with and its full name.
+    Unit {
+        prefix: Option<Prefix>,
+        canonical: CompactString,
+    },
+    /// `ans` and `_`, which the language defines.
+    Predefined,
+    /// A name in a type: a dimension.
+    Dimension,
+    /// A name in a type: a struct.
+    Struct,
+    /// Nothing defines it.
+    Unknown,
+}
+
+/// One name where it is used: the span of the use, the name as written, what it is, and the span of its definition if it has one
+/// (the span names its source, so it says whether it is the document, a module or the library).
+#[derive(Debug, Clone)]
+pub struct Use {
+    pub span: Span,
+    pub name: CompactString,
+    pub kind: UseKind,
+    pub definition: Option<Span>,
+}
+
+thread_local! {
+    /// The names resolved since they were last taken. Kept here and not in the typechecker, which is put back to what it was when a
+    /// statement fails to typecheck: the names resolved on the way to the error are exactly what is wanted then.
+    static USES: std::cell::RefCell<Vec<Use>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+pub fn record(u: Use) {
+    USES.with(|uses| uses.borrow_mut().push(u));
+}
+
+/// The names resolved since this was last called, in the order they were met, each once.
+pub fn take_uses() -> Vec<Use> {
+    let mut seen = std::collections::HashSet::new();
+    USES.with(|uses| std::mem::take(&mut *uses.borrow_mut()))
+        .into_iter()
+        .filter(|u| seen.insert((u.span.start, u.span.end, u.span.code_source_id, u.name.clone())))
+        .collect()
+}
+
+/// The unit just resolved was written with a prefix: say so, and what it is called in full.
+pub fn amend_last_unit(prefix: Prefix, full_name: &str) {
+    USES.with(|uses| {
+        if let Some(last) = uses.borrow_mut().last_mut()
+            && let UseKind::Unit { prefix: p, canonical } = &mut last.kind
+        {
+            *p = if prefix == Prefix::none() { None } else { Some(prefix) };
+            *canonical = full_name.into();
+        }
+    });
+}
+
+/// A typed hole (`?`) the typechecker found, with the type it expects there and the names Numbat itself finds relevant.
+#[derive(Debug, Clone)]
+pub struct Hole {
+    pub span: Span,
+    pub scheme: crate::TypeScheme,
+    pub matches: Vec<String>,
+}
+
+thread_local! {
+    static HOLE: std::cell::RefCell<Option<Hole>> = const { std::cell::RefCell::new(None) };
+}
+
+pub fn record_hole(hole: Hole) {
+    HOLE.with(|h| *h.borrow_mut() = Some(hole));
+}
+
+/// The typed hole found since this was last called.
+pub fn take_hole() -> Option<Hole> {
+    HOLE.with(|h| h.borrow_mut().take())
+}
+
+static CLOCK: AtomicBool = AtomicBool::new(false);
+static EXCHANGE_RATES: AtomicBool = AtomicBool::new(false);
+
+/// Called by what reads the clock.
+pub fn note_clock() {
+    CLOCK.store(true, Ordering::Relaxed);
+}
+
+/// Called by what reads the exchange rates.
+pub fn note_exchange_rates() {
+    EXCHANGE_RATES.store(true, Ordering::Relaxed);
+}
+
+/// What was read from outside since this was last called.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct Effects {
+    pub clock: bool,
+    pub exchange_rates: bool,
+}
+
+pub fn take_effects() -> Effects {
+    Effects {
+        clock: CLOCK.swap(false, Ordering::Relaxed),
+        exchange_rates: EXCHANGE_RATES.swap(false, Ordering::Relaxed),
+    }
+}

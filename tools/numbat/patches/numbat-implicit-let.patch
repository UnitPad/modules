+fn test_variable_definition_without_let() {
+    // `name = value` defines a variable as `let name = value` does.
+    expect_output("x = 3 m\nx * 2", "6 m");
+    expect_output("let y = 3 m\ny * 2", "6 m");
+    expect_output("x: Length = 3 m\nx * 2", "6 m");
+    expect_output("a = 2\nb = a * 5\nb", "10");
+    expect_output("x = 3\nx == 3", "true");
+    expect_failure("to = 3", "Expected");
+}
